pipeline {
    agent any
    tools {
        maven 'Maven3'
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Build') {
            steps {
                dir('labs/10-jenkins-intro/starter') {
                    sh 'mvn -B clean package'
                }
            }
        }
        stage('Test') {
            steps {
                dir('labs/10-jenkins-intro/starter') {
                    sh 'mvn -B test'
                }
            }
            post {
                always {
                    junit 'labs/10-jenkins-intro/starter/target/test-reports/*.xml'
                }
            }
        }
        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'labs/10-jenkins-intro/starter/target/*.jar', fingerprint: true
            }
        }
    }
}
